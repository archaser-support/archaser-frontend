{
    "name": "@archaser/web",
    "version": "0.1.0",
    "private": true,
    "description": "Archaser Next.js frontend",
    "scripts": {
        "dev": "node --disable-warning=DEP0169 ./node_modules/next/dist/bin/next dev",
        "dev:turbo": "node --disable-warning=DEP0169 ./node_modules/next/dist/bin/next dev --turbo",
        "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
        "build:amplify": "node scripts/check-amplify-ui-imports.js && node scripts/check-no-relative-product-api.js && node scripts/run-amplify-build.js",
        "start": "next start",
        "lint": "next lint",
        "type-check": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate:db-types": "node scripts/generate-db-types.js",
        "check:db-types": "node scripts/generate-db-types.js --check",
        "check:amplify-imports": "node scripts/check-amplify-ui-imports.js",
        "check:nest-api-calls": "node scripts/check-no-relative-product-api.js",
        "check:api-parity": "node scripts/check-fe-nest-api-parity.cjs",
        "test": "playwright test --config=../tests/frontend/playwright.config.ts",
        "test:unit": "vitest --config=vitest.config.mjs --run --reporter=verbose",
        "test:unit:watch": "vitest --config=vitest.config.mjs --watch",
        "test:e2e": "playwright test --config=../tests/frontend/playwright.config.ts",
        "test:e2e:local": "SKIP_WEBSERVER=true playwright test --config=../tests/frontend/playwright.config.ts",
        "test:e2e:portal": "playwright test --config=../tests/frontend/playwright.config.ts ../tests/frontend/e2e/portal/",
        "test:ui": "playwright test --config=../tests/frontend/playwright.config.ts --ui",
        "test:debug": "playwright test --config=../tests/frontend/playwright.config.ts --debug",
        "test:report": "playwright show-report"
    },
    "dependencies": {
        "@archaser/openapi-client": "file:../backend/packages/openapi-client",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.1.1",
        "@mui/material": "^7.1.1",
        "@mui/x-data-grid": "^7.28.3",
        "@mui/x-date-pickers": "^8.5.2",
        "@reduxjs/toolkit": "^2.8.2",
        "@tailwindcss/forms": "^0.5.10",
        "@tanstack/query-broadcast-client-experimental": "^5.62.0",
        "@tanstack/query-sync-storage-persister": "^5.62.0",
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-query-persist-client": "^5.62.0",
        "@types/dompurify": "^3.0.5",
        "@types/luxon": "^3.7.1",
        "@types/papaparse": "^5.3.15",
        "@types/react": "^18.3.24",
        "@types/react-dom": "^18.2.22",
        "apexcharts": "^4.7.0",
        "autoprefixer": "^10.4.19",
        "axios": "^1.8.1",
        "countries-and-timezones": "^3.7.2",
        "countries-list": "^3.1.1",
        "country-locale-map": "^1.9.9",
        "date-fns": "^4.1.0",
        "dompurify": "^3.3.0",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "html2canvas": "^1.4.1",
        "i18next": "^24.0.5",
        "i18next-resources-to-backend": "^1.2.1",
        "isomorphic-dompurify": "^2.33.0",
        "jose": "^5.9.6",
        "jspdf": "^4.0.0",
        "jspdf-autotable": "^5.0.7",
        "lucide-react": "^1.25.0",
        "luxon": "^3.7.2",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.47",
        "next": "^16.3.1",
        "next-auth": "^4.24.11",
        "next-i18n-router": "^5.5.3",
        "papaparse": "^5.4.1",
        "postcss": "^8.5.26",
        "postcss-import": "^16.1.1",
        "react": "^19.1.0",
        "react-apexcharts": "^1.7.0",
        "react-contenteditable": "^3.3.7",
        "react-datepicker": "^7.5.0",
        "react-dom": "^19.1.0",
        "react-i18next": "^15.1.3",
        "react-redux": "^9.2.0",
        "react-select": "^5.10.1",
        "recharts": "^3.10.0",
        "sass": "^1.93.2",
        "tailwindcss": "^3.4.1",
        "tldts": "^6.1.70",
        "typescript": "^5.9.2",
        "use-debounce": "^10.0.4",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.42.1",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20.19.0",
        "@typescript-eslint/eslint-plugin": "^8.41.0",
        "@typescript-eslint/parser": "^8.41.0",
        "@vitejs/plugin-react": "^4.6.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "baseline-browser-mapping": "^2.9.14",
        "eslint": "^8.57.0",
        "eslint-config-next": "^15.5.23",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "husky": "^8.0.0",
        "ignore-loader": "^0.1.2",
        "jsdom": "^26.1.0",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "esbuild": "0.24.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=9.0.0"
    }
}
